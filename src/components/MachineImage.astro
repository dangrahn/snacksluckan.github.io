---
import { Image } from 'astro:assets'
import machine from '~/assets/machine.png'

// TODO: replace with a real photo of a branded machine on location when available —
// swap the `machine` import.
interface Props {
  caption?: string
  eager?: boolean
  class?: string
}

const { caption, eager = false, class: className = '' } = Astro.props
---

<figure class={className}>
  <div class="overflow-hidden rounded-3xl ring-1 ring-sand/20">
    <Image
      src={machine}
      alt="Snacksluckans helfolierade varuautomat fylld med snacks, bars och kalla drycker"
      widths={[480, 720, 1080]}
      sizes="(min-width: 1024px) 32rem, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="h-auto w-full"
    />
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-caption">{caption}</figcaption>}
</figure>
