---
import { siteConfig } from '~/site.config'
import { withBase } from '~/utils'
import LogoMark from '~/components/LogoMark.astro'

const home = withBase('')
---

<header class="sticky top-0 z-50 border-b border-sand/10 bg-teal/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 md:px-8">
    <a href={home} class="flex items-center gap-2.5 text-sand">
      <LogoMark class="h-8 w-8" />
      <span class="font-display text-xl font-semibold tracking-tight">{siteConfig.name}</span>
    </a>
    <nav aria-label="Huvudmeny" class="hidden items-center gap-7 md:flex">
      {
        siteConfig.nav.map((item) => (
          <a href={home + item.href} class="text-sm text-mild transition-colors hover:text-cream">
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href={home + '#offert'}
      class="rounded-full bg-amber px-5 py-2 font-display text-sm font-semibold text-ink transition-colors hover:bg-ember hover:text-cream"
    >
      Få offert
    </a>
  </div>
</header>
