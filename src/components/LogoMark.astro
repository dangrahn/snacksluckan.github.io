---
// The brand mark: snacks bursting out of the lucka, drawn in the foliation's line-art style.
interface Props {
  class?: string
}
const { class: className = 'h-8 w-8' } = Astro.props
---

<svg viewBox="0 0 64 64" class={className} aria-hidden="true" fill="none">
  <g stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 40h28l-3.5 13h-21z"></path>
    <path d="M32 10v11M20 14l4.5 9M44 14l-4.5 9M10 25l9 6M54 25l-9 6"></path>
  </g>
  <circle cx="13" cy="13" r="2" fill="currentColor"></circle>
  <circle cx="51" cy="11" r="2" fill="currentColor"></circle>
</svg>
